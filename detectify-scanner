deploy_helm_chart() {
    local manifest_file="${K3S_MANIFESTS_DIR}/detectify-scanner.yaml"
    local chart_content=""

    # Embed chart as base64 tarball
    if [ -n "${EMBEDDED_CHART_CONTENT:-}" ]; then
        chart_content="$EMBEDDED_CHART_CONTENT"
    elif [ -d "helm-charts/internal-scanning-agent" ]; then
        local tmp_dir
        tmp_dir=$(mktemp -d)
        _helm_package "helm-charts/internal-scanning-agent" "$tmp_dir"
        local -a tgz_files=("$tmp_dir"/internal-scanning-agent-*.tgz)
        if [ ${#tgz_files[@]} -ne 1 ] || [ ! -f "${tgz_files[0]}" ]; then
            printf "%sError: helm package did not produce expected .tgz file.%s\n" "${RED}" "${NC}"
            printf "Check helm-charts/internal-scanning-agent/ Chart.yaml and templates.\n"
            rm -rf "$tmp_dir"
            return 1
        fi
        chart_content=$(_base64_encode < "${tgz_files[0]}")
        rm -rf "$tmp_dir"
    else
        local chart_version="${CHART_VERSION:-}"
        local chart_repo="https://raw.githubusercontent.com/detectify/helm-charts/gh-pages"

        if [ -z "$chart_version" ]; then
            printf "Fetching latest chart version...\n"
            chart_version=$(curl -sSfL "${chart_repo}/index.yaml" \
                | awk '/name: internal-scanning-agent/{found=1} found && /version:/{print $2; exit}')
            if [ -z "$chart_version" ]; then
                printf "%sError: Could not determine latest chart version from %s/index.yaml.%s\n" "${RED}" "${chart_repo}" "${NC}"
                printf "Set CHART_VERSION explicitly or provide EMBEDDED_CHART_CONTENT.\n"
                return 1
            fi
        fi

        local chart_url="${chart_repo}/internal-scanning-agent-${chart_version}.tgz"
        printf "Downloading chart v%s from %s\n" "$chart_version" "$chart_url"
        local tmp_tgz
        tmp_tgz=$(mktemp /tmp/chart-XXXXXX.tgz)
        if ! curl -sSfL -o "$tmp_tgz" "$chart_url"; then
            printf "%sError: Failed to download chart from %s.%s\n" "${RED}" "${chart_url}" "${NC}"
            printf "Check network connectivity or set CHART_VERSION to a valid version.\n"
            rm -f "$tmp_tgz"
            return 1
        fi
        chart_content=$(_base64_encode < "$tmp_tgz")
        export EMBEDDED_CHART_CONTENT="$chart_content"
        rm -f "$tmp_tgz"
        printf "Chart v%s downloaded and embedded.\n" "$chart_version"
    fi

    local values_content
    values_content=$(generate_helm_values)

    _mkdir_p "$K3S_MANIFESTS_DIR"

    # HelmChart CRD: namespace MUST be kube-system (k3s requirement)
    cat > "$manifest_file" <<HELMEOF
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: internal-scanning-agent
  namespace: kube-system
spec:
  chartContent: ${chart_content}
  targetNamespace: scanner
  createNamespace: true
  timeout: 300s
  valuesContent: |-
$(echo "$values_content" | sed 's/^/    /')
HELMEOF

    # T-02-09 mitigation: restrict manifest file permissions (contains credentials)
    _chmod 600 "$manifest_file"
    record_result "OK" "Helm chart" "Deployed HelmChart CRD to ${manifest_file}"
}

# --- Pod Readiness ---
wait_for_api_server() {
    local elapsed=0
    printf "  Waiting for k3s API server..."
    while [ "$elapsed" -lt "$API_SERVER_TIMEOUT" ]; do
        if _kubectl cluster-info >/dev/null 2>&1; then
            printf " ready.\n"
            return 0
        fi
        sleep 5
        elapsed=$((elapsed + 5))
        printf "."
    done
    printf "\n"
    printf "%sError: k3s API server not ready after %d seconds.%s\n" "${RED}" "$API_SERVER_TIMEOUT" "${NC}"
    printf "Check k3s logs: journalctl -u k3s\n"
    return 1
}

wait_for_pods() {
    printf "\n%sWaiting for scanner pods%s\n" "${BOLD}" "${NC}"

    # First wait for API server (per Research Pitfall 7)
    if ! wait_for_api_server; then
        return 1
    fi

    local elapsed=0
    while [ "$elapsed" -lt "$READINESS_TIMEOUT" ]; do
        local all_ready=true
        local status_line=""

        for pod_prefix in "${EXPECTED_PODS[@]}"; do
            local phase
            phase=$(_kubectl get pods -n scanner -l "app=${pod_prefix}" \
                -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo "NotFound")
            status_line="${status_line} ${pod_prefix}=${phase}"
            if [ "$phase" != "Running" ]; then
                all_ready=false
            fi
        done

        if [ "$all_ready" = true ]; then
            printf "\r  All pods running:${status_line}                    \n"
            record_result "OK" "Pod readiness" "All scanner pods running in namespace scanner"
            return 0
        fi

        printf "\r  Waiting for pods (%ds/%ds):${status_line}    " "$elapsed" "$READINESS_TIMEOUT"
        sleep "$POLL_INTERVAL"
        elapsed=$((elapsed + POLL_INTERVAL))
    done

    printf "\n"
    printf "%sError: Not all pods ready after %ds.%s\n" "${RED}" "$READINESS_TIMEOUT" "${NC}"
    printf "Check pod status: /usr/local/bin/k3s kubectl get pods -n scanner\n"
    return 1
}

# --- IP Detection and API Verification ---
detect_server_ip() {
    local ip=""
    # Method 1: ip route get (most reliable -- finds source IP for outbound traffic)
    ip=$(_ip_route_get_1 | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -1)

    # Method 2: fallback to hostname -I (space-separated list of all IPs)
    if [ -z "$ip" ]; then
        ip=$(_hostname_I | awk '{print $1}')
    fi

    # Method 3: parse ip addr for first non-loopback IPv4
    if [ -z "$ip" ]; then
        ip=$(_ip_addr_show | awk '/inet / && !/127.0.0.1/ {split($2,a,"/"); print a[1]; exit}')
    fi

    echo "$ip"
}

verify_api_reachability() {
    printf "\n%sVerifying scanner API reachability%s\n" "${BOLD}" "${NC}"

    local actual_port
    actual_port=$(_kubectl get svc scan-scheduler -n scanner -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo "")
    if [ -n "$actual_port" ] && [ "$actual_port" != "$NODEPORT" ]; then
        NODEPORT="$actual_port"
    fi

    local elapsed=0
    local timeout=120
    local interval=5

    while [ "$elapsed" -lt "$timeout" ]; do
        local http_code=""
        http_code=$(_curl_localhost_nodeport) || true
        if [ -n "$http_code" ] && [ "$http_code" != "000" ]; then
            record_result "OK" "API reachability" \
                "Scanner API responding on port ${NODEPORT}"

            local server_ip
            server_ip=$(detect_server_ip)
            if [ -n "$server_ip" ]; then
                printf "\n  %sScanner API: http://%s:%s%s\n" \
                    "${GREEN}" "$server_ip" "$NODEPORT" "${NC}"
            fi
            return 0
        fi

        printf "\r  Waiting for API (%ds/%ds)..." "$elapsed" "$timeout"
        sleep "$interval"
        elapsed=$((elapsed + interval))
    done

    printf "%sError: Scanner API not responding on port %s after %ds.%s\n" "${RED}" "$NODEPORT" "$timeout" "${NC}"
    printf "Check: 1) Pod logs: /usr/local/bin/k3s kubectl logs -n scanner -l app=scan-scheduler\n"
    printf "       2) Service: /usr/local/bin/k3s kubectl get svc -n scanner\n"
    printf "       3) Firewall: ensure port %s is open\n" "$NODEPORT"
    return 1
}

