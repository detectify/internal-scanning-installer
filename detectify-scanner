check_architecture() {
    local arch
    arch=$(_uname_m)
    if [ "$arch" != "x86_64" ]; then
        record_result "FAIL" "Architecture" \
            "Detected architecture: ${arch}. Only x86_64 is supported." \
            "Use an x86_64/amd64 server. ARM is not supported (Chrome has no ARM Linux builds)."
    else
        record_result "OK" "Architecture" \
            "Architecture: x86_64"
    fi
}

check_resources() {
    # RAM check
    local ram_kb ram_mb
    ram_kb=$(_meminfo_total_kb)
    ram_mb=$((ram_kb / 1024))
    if [ "$ram_mb" -lt "$HARD_MIN_RAM_MB" ]; then
        record_result "FAIL" "RAM" \
            "Detected ${ram_mb}MB RAM. Minimum required: ${HARD_MIN_RAM_MB}MB." \
            "Add more RAM or use a larger instance type. Minimum: 4GB, recommended: 8GB."
    elif [ "$ram_mb" -lt "$SOFT_REC_RAM_MB" ]; then
        record_result "WARN" "RAM" \
            "Detected ${ram_mb}MB RAM. Recommended: ${SOFT_REC_RAM_MB}MB." \
            "Consider upgrading to at least 8GB RAM for optimal performance."
    else
        record_result "OK" "RAM" \
            "Detected ${ram_mb}MB RAM (meets recommended ${SOFT_REC_RAM_MB}MB)"
    fi

    # Disk check
    local disk_gb
    disk_gb=$(_disk_available_gb)
    if [ "$disk_gb" -lt "$HARD_MIN_DISK_GB" ]; then
        record_result "FAIL" "Disk" \
            "Detected ${disk_gb}GB available disk space. Minimum required: ${HARD_MIN_DISK_GB}GB." \
            "Free up disk space or expand the filesystem. Minimum: 20GB, recommended: 50GB."
    elif [ "$disk_gb" -lt "$SOFT_REC_DISK_GB" ]; then
        record_result "WARN" "Disk" \
            "Detected ${disk_gb}GB available disk space. Recommended: ${SOFT_REC_DISK_GB}GB." \
            "Consider expanding the filesystem for optimal performance."
    else
        record_result "OK" "Disk" \
            "Detected ${disk_gb}GB available disk space (meets recommended ${SOFT_REC_DISK_GB}GB)"
    fi
}

check_systemd() {
    if ! _systemctl_exists; then
        record_result "FAIL" "Systemd" \
            "systemctl not found. This installer requires systemd." \
            "This installer requires a Linux distribution with systemd (e.g., Ubuntu 22.04+, RHEL 9+, Debian 12+)."
    elif ! _systemctl_is_running; then
        record_result "WARN" "Systemd" \
            "systemd is installed but not fully running." \
            "Check systemd status with: systemctl is-system-running"
    else
        record_result "OK" "Systemd" \
            "systemd is active and running"
    fi
}

# --- CIDR Conflict Detection ---
SELECTED_CLUSTER_CIDR=""
SELECTED_SERVICE_CIDR=""

# --- Credential Globals ---
SCANNER_LICENSE_KEY=""
SCANNER_CONNECTOR_API_KEY=""
SCANNER_REGISTRY_USER=""
SCANNER_REGISTRY_PASS=""

cidr_conflicts() {
    local cidr="$1"
    # NOTE: Only supports /16 CIDRs in the 10.x.0.0/16 range
    local first="${cidr%%.*}"             # e.g., "10" from "10.42.0.0/16"
    local rest="${cidr#*.}"
    local second="${rest%%.*}"            # e.g., "42" from "10.42.0.0/16"
    local pattern="${first}\.${second}\."
    # Check ip route for overlapping entries
    _ip_route_show | grep -qE "^${pattern}" && return 0
    _ip_route_show_table_all | grep -qE " ${pattern}" && return 0
    # Check ip addr for interface addresses in this range
    _ip_addr_show | grep -qE "inet ${pattern}" && return 0
    return 1
}

find_alternative_cidr() {
    local default_cidr="$1"
    local exclude="${2:-}"
    # Try alternatives: 244, 245, 246, 247, 248, 249
    for octet in 244 245 246 247 248 249; do
        local candidate="10.${octet}.0.0/16"
        [ "$candidate" = "$exclude" ] && continue
        if ! cidr_conflicts "$candidate"; then
            echo "$candidate"
            return 0
        fi
    done
    return 1  # All alternatives conflict
}

check_cidr() {
    # Check cluster CIDR (default: 10.42.0.0/16)
    if cidr_conflicts "$K3S_DEFAULT_CLUSTER_CIDR"; then
        local alt_cluster
        alt_cluster=$(find_alternative_cidr "$K3S_DEFAULT_CLUSTER_CIDR" || true)
        if [ -n "$alt_cluster" ]; then
            SELECTED_CLUSTER_CIDR="$alt_cluster"
            record_result "WARN" "Cluster CIDR" \
                "Default ${K3S_DEFAULT_CLUSTER_CIDR} conflicts with existing routes. Will use ${alt_cluster} instead." \
                "No action needed. Alternative CIDR selected automatically."
        else
            record_result "FAIL" "Cluster CIDR" \
                "Default ${K3S_DEFAULT_CLUSTER_CIDR} conflicts and no alternative found in 10.{244-249}.0.0/16 range." \
                "Free up a /16 network range or manually specify --cluster-cidr during k3s installation."
        fi
    else
        SELECTED_CLUSTER_CIDR="$K3S_DEFAULT_CLUSTER_CIDR"
        record_result "OK" "Cluster CIDR" \
            "Using default ${K3S_DEFAULT_CLUSTER_CIDR} (no conflicts detected)"
    fi

    # Check service CIDR (default: 10.43.0.0/16)
    if cidr_conflicts "$K3S_DEFAULT_SERVICE_CIDR"; then
        local alt_service
        alt_service=$(find_alternative_cidr "$K3S_DEFAULT_SERVICE_CIDR" "$SELECTED_CLUSTER_CIDR" || true)
        if [ -n "$alt_service" ]; then
            SELECTED_SERVICE_CIDR="$alt_service"
            record_result "WARN" "Service CIDR" \
                "Default ${K3S_DEFAULT_SERVICE_CIDR} conflicts with existing routes. Will use ${alt_service} instead." \
                "No action needed. Alternative CIDR selected automatically."
        else
            record_result "FAIL" "Service CIDR" \
                "Default ${K3S_DEFAULT_SERVICE_CIDR} conflicts and no alternative found in 10.{244-249}.0.0/16 range." \
                "Free up a /16 network range or manually specify --service-cidr during k3s installation."
        fi
    else
        SELECTED_SERVICE_CIDR="$K3S_DEFAULT_SERVICE_CIDR"
        record_result "OK" "Service CIDR" \
            "Using default ${K3S_DEFAULT_SERVICE_CIDR} (no conflicts detected)"
    fi
}

check_connectivity() {
    if _curl_exists; then
        for endpoint in "${REQUIRED_ENDPOINTS[@]}"; do
            local exit_code=0
            _curl_check "$endpoint" || exit_code=$?
            if [ "$exit_code" -eq 0 ]; then
                record_result "OK" "Connectivity: ${endpoint}" \
                    "Successfully reached https://${endpoint}"
            elif [ "$exit_code" -eq 60 ]; then
                record_result "FAIL" "Connectivity: ${endpoint}" \
                    "TLS/SSL error connecting to https://${endpoint}. CA certificates may be missing or outdated." \
                    "$(get_install_cmd ca-certificates) && update-ca-certificates. Test with: curl -v https://${endpoint}"
            else
                record_result "FAIL" "Connectivity: ${endpoint}" \
                    "Cannot reach https://${endpoint} (curl exit code: ${exit_code})" \
                    "Check DNS resolution, firewall rules, and proxy settings. Test with: curl -v https://${endpoint}"
            fi
        done
    elif _wget_exists; then
        for endpoint in "${REQUIRED_ENDPOINTS[@]}"; do
            if _wget_check "$endpoint"; then
                record_result "OK" "Connectivity: ${endpoint}" \
                    "Successfully reached https://${endpoint}"
            else
                record_result "FAIL" "Connectivity: ${endpoint}" \
                    "Cannot reach https://${endpoint}" \
                    "Check DNS resolution, firewall rules, and proxy settings."
            fi
        done
    else
        record_result "FAIL" "Connectivity tools" \
            "Neither curl nor wget found. Cannot verify network connectivity." \
            "$(get_install_cmd curl)"
    fi
}

preflight_checks() {
    check_root
    check_architecture
    check_resources
    check_systemd
    check_cidr
    check_connectivity
    check_security_frameworks
}

check_security_frameworks() {
    # SELinux -- per D-09: warn, don't block. Per Pitfall 5: only warn on Enforcing.
    if _getenforce_exists; then
        local selinux_status
        selinux_status=$(_getenforce)
        if [ "$selinux_status" = "Enforcing" ]; then
            record_result "WARN" "SELinux" \
                "SELinux is in Enforcing mode. k3s will install the k3s-selinux policy package automatically." \
                "No action needed. If issues occur: sudo setenforce 0 (temporary) or edit /etc/selinux/config (permanent)"
        else
            record_result "OK" "SELinux" \
                "SELinux status: ${selinux_status}"
        fi
    fi

    # AppArmor
    if _apparmor_loaded; then
        local apparmor_status="loaded"
        if _aa_status_exists; then
            _aa_status_enabled && apparmor_status="enabled" || apparmor_status="loaded but not enforcing"
        fi
        record_result "OK" "AppArmor" \
            "AppArmor is ${apparmor_status}. k3s handles AppArmor profiles automatically."
    fi

    # Firewalld
    if _firewalld_active; then
        record_result "WARN" "Firewalld" \
            "firewalld is active. k3s requires ports 6443/tcp, 8472/udp, 10250/tcp, and pod/service CIDR traffic." \
            "k3s manages iptables rules directly. If issues occur: sudo firewall-cmd --add-port=6443/tcp --permanent && sudo firewall-cmd --add-port=8472/udp --permanent && sudo firewall-cmd --add-port=10250/tcp --permanent && sudo firewall-cmd --reload"
    fi

    # UFW
    if _ufw_exists; then
        local ufw_status
        ufw_status=$(_ufw_status)
        if echo "$ufw_status" | grep -qi "^Status: active" && ! echo "$ufw_status" | grep -qi "inactive"; then
            record_result "WARN" "UFW" \
                "UFW is active. k3s requires ports 6443/tcp, 8472/udp, 10250/tcp." \
                "sudo ufw allow 6443/tcp && sudo ufw allow 8472/udp && sudo ufw allow 10250/tcp"
        fi
    fi

    # nftables
    if _nft_exists; then
        local table_count
        table_count=$(_nft_table_count)
        if [ "$table_count" -gt 0 ] 2>/dev/null; then
            record_result "WARN" "nftables" \
                "nftables is active with ${table_count} table(s). k3s uses iptables; ensure iptables-nft compatibility." \
                "Most modern distros use iptables-nft (iptables backed by nftables) which is compatible with k3s."
        fi
    fi
}

# --- Report Rendering ---
render_report() {
    echo ""
    printf "%sPre-flight Check Results%s\n" "${BOLD}" "${NC}"
    echo "========================"
    echo ""

    for result in "${RESULTS[@]}"; do
        IFS='|' read -r status name message fix <<< "$result"
        case "$status" in
            OK)   printf "  %s[%s]%s %s: %s\n" "${GREEN}" "${ICON_OK}" "${NC}" "$name" "$message" ;;
            WARN) printf "  %s[%s]%s %s: %s\n" "${YELLOW}" "${ICON_WARN}" "${NC}" "$name" "$message"
                  [ -n "$fix" ] && printf "      Fix: %s\n" "$fix" ;;
            FAIL) printf "  %s[%s]%s %s: %s\n" "${RED}" "${ICON_FAIL}" "${NC}" "$name" "$message"
                  [ -n "$fix" ] && printf "      Fix: %s\n" "$fix" ;;
        esac
    done

    echo ""
    printf "Summary: %s%d passed%s, %s%d warning(s)%s, %s%d failed%s\n" \
        "${GREEN}" "$OK_COUNT" "${NC}" \
        "${YELLOW}" "$WARN_COUNT" "${NC}" \
        "${RED}" "$FAIL_COUNT" "${NC}"

    if [ "$FAIL_COUNT" -gt 0 ]; then
        echo ""
        printf "%s%sPre-flight checks failed. Please resolve the issues above before installing.%s\n" "${RED}" "${BOLD}" "${NC}"
        return 1
    elif [ "$WARN_COUNT" -gt 0 ]; then
        echo ""
        printf "%sPre-flight checks passed with warnings. Installation will proceed.%s\n" "${YELLOW}" "${NC}"
        return 0
    else
        echo ""
        printf "%sAll pre-flight checks passed.%s\n" "${GREEN}" "${NC}"
        return 0
    fi
}

# --- Helper Functions (shared by install guard and reconfigure) ---

mask_value() {
    local val="$1"
    local len=${#val}
    if [ "$len" -le 8 ]; then
        printf '%s%s' "${val:0:2}" "$(printf '%*s' $((len - 2)) '' | tr ' ' '*')"
    else
        printf '%s***%s' "${val:0:3}" "${val: -3}"
    fi
}

display_config_summary() {
    printf "  License key:       %s\n" "$(mask_value "$SCANNER_LICENSE_KEY")"
    printf "  Connector API key: %s\n" "$(mask_value "$SCANNER_CONNECTOR_API_KEY")"
    printf "  Registry user:     %s\n" "$(mask_value "$SCANNER_REGISTRY_USER")"
    printf "  Registry password: %s\n" "$(mask_value "$SCANNER_REGISTRY_PASS")"
}

prompt_with_default() {
    local label="$1" current="$2" varname="$3" is_secret="${4:-false}"
    local masked
    masked=$(mask_value "$current")
    if [ "$is_secret" = true ]; then
        _read_secret "${label} [${masked}]: " "$varname"
    else
        _read_input "${label} [${masked}]: " "$varname"
    fi
    local val
    eval "val=\$$varname"
    if [ -z "$val" ]; then
        printf -v "$varname" '%s' "$current"
    fi
}

show_changes_and_confirm() {
    local old_license="$1" new_license="$2"
    local old_connector="$3" new_connector="$4"
    local old_reg_user="$5" new_reg_user="$6"
    local old_reg_pass="$7" new_reg_pass="$8"
    local has_changes=false

    printf "\n%sProposed changes:%s\n" "${BOLD}" "${NC}"
    if [ "$new_license" != "$old_license" ]; then
        printf "  License key:       %s -> %s\n" "$(mask_value "$old_license")" "$(mask_value "$new_license")"
        has_changes=true
    fi
    if [ "$new_connector" != "$old_connector" ]; then
        printf "  Connector API key: %s -> %s\n" "$(mask_value "$old_connector")" "$(mask_value "$new_connector")"
        has_changes=true
    fi
    if [ "$new_reg_user" != "$old_reg_user" ]; then
        printf "  Registry user:     %s -> %s\n" "$(mask_value "$old_reg_user")" "$(mask_value "$new_reg_user")"
        has_changes=true
    fi
    if [ "$new_reg_pass" != "$old_reg_pass" ]; then
        printf "  Registry password: %s -> %s\n" "$(mask_value "$old_reg_pass")" "$(mask_value "$new_reg_pass")"
        has_changes=true
    fi

    if [ "$has_changes" = false ]; then
        return 1
    fi

    printf "\nApply these changes? [y/N]: "
    local confirm=""
    _read_input "" confirm
    [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]
}

# --- Main Entry Point ---
main() {
    local command="${1:-install}"
    shift 2>/dev/null || true

    case "$command" in
        install)
            # Idempotency guard: detect existing installation (per D-01, D-02, D-03)
            if [ -f "$CONFIG_FILE" ]; then
                # shellcheck source=/dev/null
                source "$CONFIG_FILE"
                printf "%sDetectify Scanner is already installed.%s\n\n" "${BOLD}" "${NC}"
                display_config_summary
                printf "\nTo change credentials: %sdetectify-scanner reconfigure%s\n" "${BOLD}" "${NC}"
                printf "To reinstall:          %sdetectify-scanner uninstall%s first, then install again\n" "${BOLD}" "${NC}"
                exit 0
            fi

            printf "%sDetectify Internal Scanner Installer v%s%s\n" "${BOLD}" "${SCRIPT_VERSION}" "${NC}"
            echo ""

            # Step 1: Pre-flight checks (Phase 1)
            preflight_checks
            render_report || exit 1

            # Step 2: Collect and validate credentials (per D-01 through D-04)
            prompt_credentials || exit 1

            # Step 3: Persist configuration (per D-13 through D-15)
            persist_config

            # Step 4: Write registry auth BEFORE k3s starts (per Research Pitfall 1)
            write_registries_yaml

            # Step 5: Install k3s (per D-05 through D-08)
            install_k3s || exit 1

            # Step 6: Deploy Helm chart via HelmChart CRD (per D-09 through D-11)
            deploy_helm_chart || exit 1

            # Step 7: Wait for all pods to be ready (per D-12)
            wait_for_pods || exit 1

            # Step 8: Verify scanner API is reachable on NodePort (per D-04)
            verify_api_reachability || exit 1

            # Make kubectl usable without sudo
            if [ -f /etc/rancher/k3s/k3s.yaml ]; then
                local install_user="${SUDO_USER:-}"
                if [ -n "$install_user" ]; then
                    local user_home user_group
                    user_home=$(eval echo "~${install_user}")
                    user_group=$(id -gn "$install_user")
                    _mkdir_p "${user_home}/.kube"
                    cp /etc/rancher/k3s/k3s.yaml "${user_home}/.kube/config"
                    chown -R "${install_user}:${user_group}" "${user_home}/.kube"
                    chmod 600 "${user_home}/.kube/config"
                    if ! grep -q 'KUBECONFIG=' "${user_home}/.bashrc" 2>/dev/null; then
                        printf '\nexport KUBECONFIG=~/.kube/config\n' >> "${user_home}/.bashrc"
                        chown "${install_user}:${user_group}" "${user_home}/.bashrc"
                    fi
                fi
            fi

            # Final success message
            echo ""
            printf "%s%sInstallation complete!%s\n" "${GREEN}" "${BOLD}" "${NC}"
            printf "Scanner is running. All pods are healthy in the 'scanner' namespace.\n"
            printf "Configuration saved to %s\n" "$CONFIG_FILE"
            local final_ip
            final_ip=$(detect_server_ip)
            if [ -n "$final_ip" ]; then
                printf "\n%sScanner API: http://%s:%s%s\n" "${BOLD}" "$final_ip" "$NODEPORT" "${NC}"
                printf "Use this URL to configure your CI/CD pipelines or to start a scan manually.\n"
            fi
            ;;
        preflight)
            # Standalone pre-flight mode (future: OPS-07)
            preflight_checks
            render_report || exit 1
            ;;
        status)
            status_command
            ;;
        logs)
            logs_command "$@"
            ;;
        restart)
            restart_command "$@"
            ;;
        update)
            update_command
            ;;
        reconfigure)
            reconfigure_command
            ;;
        uninstall)
            uninstall_command
            ;;
        *)
            echo "Unknown command: $command"
            echo "Usage: detectify-scanner [install|preflight|status|logs|restart|update|reconfigure|uninstall]"
            exit 1
            ;;
    esac
}

# Wrap in main() to prevent partial-download execution (Tailscale pattern)
if [ "${SOURCED_FOR_TESTING:-}" != "true" ]; then
    setup_colors
    detect_distro
    main "$@"
fi
