# --- Registry Auth (must run BEFORE k3s install) ---
write_registries_yaml() {
    local user="${SCANNER_REGISTRY_USER}"
    local pass="${SCANNER_REGISTRY_PASS}"

    _mkdir_p "$(dirname "$K3S_REGISTRIES_YAML")"

    # Use single-quoted YAML strings to avoid interpretation of special chars.
    # Escape single quotes within values by doubling them (YAML spec).
    user="${user//\'/\'\'}"
    pass="${pass//\'/\'\'}"

    cat > "$K3S_REGISTRIES_YAML" <<REGEOF
mirrors:
  ${REGISTRY_HOST}:
    endpoint:
      - "https://${REGISTRY_HOST}"
configs:
  "${REGISTRY_HOST}":
    auth:
      username: '${user}'
      password: '${pass}'
REGEOF

    _chmod 600 "$K3S_REGISTRIES_YAML"
    record_result "OK" "Registry auth" "Configured containerd registry auth at ${K3S_REGISTRIES_YAML}"
}

# --- k3s Installation ---
install_k3s() {
    local -a extra_args=()

    # CIDR overrides from Phase 1 (per D-08)
    if [ -n "$SELECTED_CLUSTER_CIDR" ] && \
       [ "$SELECTED_CLUSTER_CIDR" != "$K3S_DEFAULT_CLUSTER_CIDR" ]; then
        extra_args+=("--cluster-cidr=${SELECTED_CLUSTER_CIDR}")
    fi
    if [ -n "$SELECTED_SERVICE_CIDR" ] && \
       [ "$SELECTED_SERVICE_CIDR" != "$K3S_DEFAULT_SERVICE_CIDR" ]; then
        extra_args+=("--service-cidr=${SELECTED_SERVICE_CIDR}")
    fi

    printf "\n%sInstalling k3s %s%s\n" "${BOLD}" "${K3S_VERSION}" "${NC}"
    if _k3s_install "${extra_args[@]}"; then
        record_result "OK" "k3s installation" "k3s ${K3S_VERSION} installed successfully"
    else
        printf "%sError: k3s installation failed.%s\n" "${RED}" "${NC}"
        printf "Check internet connectivity and try again. Logs: journalctl -u k3s\n"
        return 1
    fi
}

