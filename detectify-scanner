#!/usr/bin/env bash
# detectify-scanner -- Standalone installer for Detectify Internal Scanning
# Usage: curl -sSL https://example.com/install.sh | bash
set -o pipefail
SCRIPT_VERSION="2.0.0"

# --- Constants from values.yaml (source of truth) ---
REGISTRY_HOST="${SCANNER_REGISTRY_HOST:-registry.detectify.com}"
LICENSE_HOST="${SCANNER_LICENSE_HOST:-license.detectify.com}"
CONNECTOR_HOST="${SCANNER_CONNECTOR_HOST:-connector.detectify.com}"
REQUIRED_ENDPOINTS=("$REGISTRY_HOST" "$LICENSE_HOST" "$CONNECTOR_HOST")
K3S_DEFAULT_CLUSTER_CIDR="10.42.0.0/16"
K3S_DEFAULT_SERVICE_CIDR="10.43.0.0/16"
HARD_MIN_RAM_MB=4096
SOFT_REC_RAM_MB=8192
HARD_MIN_DISK_GB=20
SOFT_REC_DISK_GB=50
K3S_VERSION="v1.31.6+k3s1"
READINESS_TIMEOUT=300
POLL_INTERVAL=10
CONFIG_DIR="/etc/detectify-scanner"
CONFIG_FILE="${CONFIG_DIR}/scanner.env"
MAX_REGISTRY_ATTEMPTS=3
K3S_REGISTRIES_YAML="/etc/rancher/k3s/registries.yaml"
K3S_MANIFESTS_DIR="/var/lib/rancher/k3s/server/manifests"
EXPECTED_PODS=("scan-scheduler" "scan-manager" "chrome-controller" "redis")
API_SERVER_TIMEOUT=120
NODEPORT=30000

# --- Result Collection Globals ---
RESULTS=()
FAIL_COUNT=0
WARN_COUNT=0
OK_COUNT=0

# Record a check result
# Usage: record_result "OK|WARN|FAIL" "Check name" "Detail message" ["Fix command"]
record_result() {
    local status="$1" name="$2" message="$3" fix="${4:-}"
    RESULTS+=("${status}|${name}|${message}|${fix}")
    case "$status" in
        OK)   OK_COUNT=$((OK_COUNT + 1)) ;;
        WARN) WARN_COUNT=$((WARN_COUNT + 1)) ;;
        FAIL) FAIL_COUNT=$((FAIL_COUNT + 1)) ;;
    esac
}

# --- TTY-Aware Output ---
setup_colors() {
    if [ -t 1 ] && [ -t 2 ]; then
        RED=$'\033[0;31m'
        GREEN=$'\033[0;32m'
        YELLOW=$'\033[1;33m'
        BOLD=$'\033[1m'
        NC=$'\033[0m'
        ICON_OK='✓'
        ICON_WARN='⚠'
        ICON_FAIL='✗'
    else
        RED=''
        GREEN=''
        YELLOW=''
        BOLD=''
        NC=''
        ICON_OK='OK'
        ICON_WARN='WARN'
        ICON_FAIL='FAIL'
    fi
}

# --- Distro Detection ---
detect_distro() {
    if [ -f /etc/os-release ]; then
        # shellcheck source=/dev/null
        . /etc/os-release
        DISTRO_ID="${ID}"
        DISTRO_VERSION="${VERSION_ID}"
        DISTRO_FAMILY="${ID_LIKE:-${ID}}"
    else
        DISTRO_ID="unknown"
        DISTRO_VERSION="unknown"
        DISTRO_FAMILY="unknown"
    fi
}

# Return distro-specific install command for a given package
get_install_cmd() {
    local package="$1"
    case "$DISTRO_FAMILY" in
        *debian*|*ubuntu*) echo "sudo apt-get install -y ${package}" ;;
        *rhel*|*fedora*|*centos*) echo "sudo dnf install -y ${package}" ;;
        *suse*) echo "sudo zypper install -y ${package}" ;;
        *) echo "Install '${package}' using your package manager" ;;
    esac
}

# --- Testability Wrappers ---
_uname_m() { uname -m; }
_meminfo_total_kb() { awk '/^MemTotal:/ { print $2 }' /proc/meminfo; }
_disk_available_gb() { LANG=C df -BG / | awk 'NR==2 { gsub(/G/,"",$4); print $4 }'; }
_systemctl_exists() { command -v systemctl >/dev/null 2>&1; }
_systemctl_is_running() { systemctl is-system-running >/dev/null 2>&1; }
_ip_route_show() { ip route show 2>/dev/null; }
_ip_route_show_table_all() { ip route show table all 2>/dev/null; }
_ip_addr_show() { ip addr show 2>/dev/null; }
_curl_exists() { command -v curl >/dev/null 2>&1; }
_wget_exists() { command -v wget >/dev/null 2>&1; }
_curl_check() {
    local endpoint="$1"
    curl -sS --connect-timeout 10 --max-time 15 "https://${endpoint}/" -o /dev/null < /dev/null
}
_wget_check() {
    local endpoint="$1"
    wget -q --timeout=15 --spider "https://${endpoint}/" 2>/dev/null < /dev/null
}
_getenforce_exists() { command -v getenforce >/dev/null 2>&1; }
_getenforce() { getenforce 2>/dev/null; }
_apparmor_loaded() { [ -d /sys/module/apparmor ]; }
_aa_status_exists() { command -v aa-status >/dev/null 2>&1; }
_aa_status_enabled() { aa-status --enabled 2>/dev/null; }
_firewalld_active() { command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; }
_ufw_exists() { command -v ufw >/dev/null 2>&1; }
_ufw_status() { ufw status 2>/dev/null | head -1; }
_nft_exists() { command -v nft >/dev/null 2>&1; }
_nft_table_count() { nft list tables 2>/dev/null | wc -l; }
_read_input() {
    local prompt="$1" varname="$2"
    read -rp "$prompt" "$varname"
}
_read_secret() {
    local prompt="$1" varname="$2"
    read -rsp "$prompt" "$varname"
    echo  # newline after hidden input
}
_curl_registry_auth() {
    local user="$1" pass="$2"
    curl -sS -o /dev/null -w "%{http_code}" \
        --connect-timeout 10 --max-time 15 \
        -u "${user}:${pass}" \
        "https://${REGISTRY_HOST}/v2/" < /dev/null
}
_curl_license_validate() {
    local license_key="$1" api_key="$2"
    curl -sS -o /dev/null -w "%{http_code}" \
        --connect-timeout 10 --max-time 15 \
        -X POST -H "Content-Type: application/json" \
        -H "Authorization: Bearer ${api_key}" \
        -d "{\"license_key\":\"${license_key}\"}" \
        "https://${LICENSE_HOST}/v1/validate" < /dev/null
}
_mkdir_p() { mkdir -p "$1"; }
_chmod() { chmod "$1" "$2"; }
_write_file() {
    local path="$1"
    shift
    printf '%s\n' "$@" > "$path"
}
_date_utc() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
_k3s_install() {
    curl -sfL https://get.k3s.io | \
        INSTALL_K3S_VERSION="${K3S_VERSION}" \
        sh -s - server \
        --disable=traefik \
        --disable=servicelb \
        "$@"
}
_kubectl() {
    /usr/local/bin/k3s kubectl "$@"
}
_base64_encode() {
    base64 -w0
}
_helm_package() {
    local chart_dir="$1" output_dir="$2"
    helm package "$chart_dir" -d "$output_dir"
}
_ip_route_get_1() { ip route get 1 2>/dev/null; }
_hostname_I() { hostname -I 2>/dev/null; }
_curl_localhost_nodeport() {
    curl -s -o /dev/null -w "%{http_code}" --connect-timeout 5 \
        "http://localhost:${NODEPORT}/" 2>/dev/null
}
_systemctl_is_active() { systemctl is-active "$1" 2>/dev/null; }
_df_root_usage() { LANG=C df -BG / | awk 'NR==2 { print $3, $4, $5 }'; }
_k3s_uninstall_script() { /usr/local/bin/k3s-uninstall.sh; }
_rm_rf() { rm -rf "$1"; }
_rm_f() { rm -f "$1"; }

# --- Component Validation ---
VALID_COMPONENTS=("scan-scheduler" "scan-manager" "chrome-controller" "redis")

validate_component() {
    local component="$1"
    for valid in "${VALID_COMPONENTS[@]}"; do
        if [ "$component" = "$valid" ]; then
            return 0
        fi
    done
    printf "Unknown component: %s\n" "$component"
    printf "Valid components: %s\n" "${VALID_COMPONENTS[*]}"
    return 1
}

require_k3s() {
    if [ ! -x "/usr/local/bin/k3s" ]; then
        printf "%sError: Scanner is not installed. Run 'detectify-scanner install' first.%s\n" "${RED}" "${NC}"
        return 1
    fi
}

# --- Management Commands ---
status_command() {
    require_k3s || return 1

    printf "%sDetectify Scanner Status%s\n" "${BOLD}" "${NC}"
    echo "========================"
    echo ""

    local overall_ok=true

    # k3s service health
    local k3s_status
    k3s_status=$(_systemctl_is_active "k3s") || true
    if [ "$k3s_status" = "active" ]; then
        record_result "OK" "k3s service" "Running"
    else
        record_result "FAIL" "k3s service" "Status: ${k3s_status:-not found}" \
            "Start k3s: sudo systemctl start k3s"
        overall_ok=false
    fi

    # Pod health for each component
    for component in "${EXPECTED_PODS[@]}"; do
        local phase
        phase=$(_kubectl get pods -n scanner -l "app=${component}" \
            -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo "NotFound")
        if [ "$phase" = "Running" ]; then
            record_result "OK" "${component}" "Running"
        else
            record_result "FAIL" "${component}" "${phase}" \
                "Check logs: detectify-scanner logs ${component}"
            overall_ok=false
        fi
    done

    # API reachability (single check, no retry loop)
    local actual_port
    actual_port=$(_kubectl get svc scan-scheduler -n scanner -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || echo "")
    if [ -n "$actual_port" ] && [ "$actual_port" != "$NODEPORT" ]; then
        NODEPORT="$actual_port"
    fi
    local http_code=""
    http_code=$(_curl_localhost_nodeport) || true
    if [ -n "$http_code" ] && [ "$http_code" != "000" ]; then
        local server_ip
        server_ip=$(detect_server_ip)
        record_result "OK" "API reachability" "http://${server_ip}:${NODEPORT} responding"
    else
        record_result "FAIL" "API reachability" "Port ${NODEPORT} not responding" \
            "Try: detectify-scanner restart"
        overall_ok=false
    fi

    # Disk usage
    local disk_info
    disk_info=$(_df_root_usage) || true
    record_result "OK" "Disk usage" "${disk_info}"

    # Render results
    echo ""
    for result in "${RESULTS[@]}"; do
        IFS='|' read -r status name message fix <<< "$result"
        case "$status" in
            OK)   printf "  %s[%s]%s %s: %s\n" "${GREEN}" "${ICON_OK}" "${NC}" "$name" "$message" ;;
            WARN) printf "  %s[%s]%s %s: %s\n" "${YELLOW}" "${ICON_WARN}" "${NC}" "$name" "$message"
                  [ -n "$fix" ] && printf "      Fix: %s\n" "$fix" ;;
            FAIL) printf "  %s[%s]%s %s: %s\n" "${RED}" "${ICON_FAIL}" "${NC}" "$name" "$message"
                  [ -n "$fix" ] && printf "      Fix: %s\n" "$fix" ;;
        esac
    done

    echo ""
    if [ "$overall_ok" = true ]; then
        printf "%s%sAll systems healthy.%s\n" "${GREEN}" "${BOLD}" "${NC}"
        return 0
    else
        printf "%s%sSome checks failed. See above for details.%s\n" "${RED}" "${BOLD}" "${NC}"
        return 1
    fi
}

logs_command() {
    require_k3s || return 1

    local component=""
    local follow=false
    local tail_lines=50

    # Parse arguments
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--follow) follow=true; shift ;;
            *) component="$1"; shift ;;
        esac
    done

    local kubectl_args=(logs -n scanner --tail="$tail_lines")

    if [ -n "$component" ]; then
        validate_component "$component" || return 1
        kubectl_args+=(-l "app=${component}")
    else
        kubectl_args+=(--all-containers --prefix -l "app in (scan-scheduler,scan-manager,chrome-controller,redis)")
    fi

    if [ "$follow" = true ]; then
        kubectl_args+=(-f)
    fi

    _kubectl "${kubectl_args[@]}"
}

restart_command() {
    require_k3s || return 1

    local component="${1:-}"

    if [ -n "$component" ]; then
        validate_component "$component" || return 1
        printf "Restarting %s...\n" "$component"
        _kubectl rollout restart "deployment/${component}" -n scanner || {
            printf "%sFailed to restart %s.%s\n" "${RED}" "$component" "${NC}"
            return 1
        }
        printf "  Waiting for rollout to complete...\n"
        _kubectl rollout status "deployment/${component}" -n scanner --timeout=120s || {
            printf "%sRollout did not complete within timeout.%s\n" "${RED}" "${NC}"
            return 1
        }
    else
        printf "Restarting all scanner components...\n"
        for dep in "${EXPECTED_PODS[@]}"; do
            printf "  Restarting %s...\n" "$dep"
            _kubectl rollout restart "deployment/${dep}" -n scanner || {
                printf "%sFailed to restart %s.%s\n" "${RED}" "$dep" "${NC}"
                return 1
            }
        done
        printf "  Waiting for rollouts to complete...\n"
        for dep in "${EXPECTED_PODS[@]}"; do
            _kubectl rollout status "deployment/${dep}" -n scanner --timeout=120s || {
                printf "%sRollout of %s did not complete within timeout.%s\n" "${RED}" "$dep" "${NC}"
                return 1
            }
        done
    fi

    printf "\n%s%sRestart complete.%s\n" "${GREEN}" "${BOLD}" "${NC}"
}

update_command() {
    require_k3s || return 1

    local manifest_file="${K3S_MANIFESTS_DIR}/detectify-scanner.yaml"
    if [ ! -f "$manifest_file" ]; then
        printf "%sError: Scanner not installed. Run 'detectify-scanner install' first.%s\n" "${RED}" "${NC}"
        return 1
    fi

    printf "%sUpdating scanner to latest images...%s\n" "${BOLD}" "${NC}"

    # Source saved credentials so generate_helm_values() can use them
    if [ -f "$CONFIG_FILE" ]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
        # Refresh host globals from persisted config (overrides may differ from defaults)
        REGISTRY_HOST="${SCANNER_REGISTRY_HOST:-$REGISTRY_HOST}"
        LICENSE_HOST="${SCANNER_LICENSE_HOST:-$LICENSE_HOST}"
        CONNECTOR_HOST="${SCANNER_CONNECTOR_HOST:-$CONNECTOR_HOST}"
    else
        printf "%sError: Config file not found at %s. Cannot update without credentials.%s\n" "${RED}" "$CONFIG_FILE" "${NC}"
        return 1
    fi

    # Capture current image IDs for before/after comparison
    local before=""
    before=$(_kubectl get pods -n scanner \
        -o jsonpath='{range .items[*]}{.spec.containers[0].name}={.status.containerStatuses[0].imageID}{"\n"}{end}' 2>/dev/null || true)

    # Redeploy by rewriting HelmChart CRD manifest (triggers k3s Helm controller)
    deploy_helm_chart || {
        printf "%sFailed to update scanner deployment.%s\n" "${RED}" "${NC}"
        return 1
    }

    # Wait for pods to restart with new images
    printf "  Waiting for pods to restart with latest images...\n"
    wait_for_pods || {
        printf "%sPods did not become ready after update.%s\n" "${RED}" "${NC}"
        return 1
    }

    # Show after image IDs
    local after=""
    after=$(_kubectl get pods -n scanner \
        -o jsonpath='{range .items[*]}{.spec.containers[0].name}={.status.containerStatuses[0].imageID}{"\n"}{end}' 2>/dev/null || true)

    if [ -n "$before" ] && [ -n "$after" ]; then
        if [ "$before" = "$after" ]; then
            printf "\n  Images unchanged (already running latest).\n"
        else
            printf "\n  Images updated successfully.\n"
        fi
    fi

    printf "\n%s%sUpdate complete.%s\n" "${GREEN}" "${BOLD}" "${NC}"
}

uninstall_command() {
    printf "%s%sWARNING: This will completely remove the Detectify scanner.%s\n" "${RED}" "${BOLD}" "${NC}"
    printf "The following will be removed:\n"
    printf "  - k3s and all Kubernetes components\n"
    printf "  - Scanner configuration (%s)\n" "$CONFIG_DIR"
    printf "  - Scanner data (/var/lib/rancher/)\n"
    printf "  - This script (/usr/local/bin/detectify-scanner)\n"
    echo ""
    printf "Type 'uninstall' to confirm: "

    local confirmation=""
    _read_input "" confirmation
    if [ "$confirmation" != "uninstall" ]; then
        printf "Uninstall cancelled.\n"
        return 1
    fi

    echo ""

    # Step 1: Remove k3s (handles pods, services, systemd unit)
    if [ -x "/usr/local/bin/k3s-uninstall.sh" ]; then
        printf "  Removing k3s...\n"
        _k3s_uninstall_script || {
            printf "%sWarning: k3s uninstall script returned an error.%s\n" "${YELLOW}" "${NC}"
        }
    else
        printf "  k3s-uninstall.sh not found (k3s may already be removed).\n"
    fi

    # Step 2: Remove scanner config
    if [ -d "$CONFIG_DIR" ]; then
        printf "  Removing scanner configuration (%s)...\n" "$CONFIG_DIR"
        _rm_rf "$CONFIG_DIR"
    fi

    # Step 3: Remove k3s data (if k3s-uninstall.sh missed it)
    if [ -d "/var/lib/rancher" ]; then
        printf "  Removing k3s data (/var/lib/rancher/)...\n"
        _rm_rf "/var/lib/rancher"
    fi

    # Step 4: Remove this script
    printf "  Removing installer script (/usr/local/bin/detectify-scanner)...\n"
    _rm_f "/usr/local/bin/detectify-scanner"

    printf "\n%s%sUninstall complete.%s Server returned to pre-install state.\n" "${GREEN}" "${BOLD}" "${NC}"
}

reconfigure_command() {
    require_k3s || return 1

    if [ ! -f "$CONFIG_FILE" ]; then
        printf "%sError: No existing configuration found at %s.%s\n" "${RED}" "$CONFIG_FILE" "${NC}"
        printf "Run 'detectify-scanner install' first.\n"
        return 1
    fi

    # Load current config
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
    # Refresh host globals from persisted config (overrides may differ from defaults)
    REGISTRY_HOST="${SCANNER_REGISTRY_HOST:-$REGISTRY_HOST}"
    LICENSE_HOST="${SCANNER_LICENSE_HOST:-$LICENSE_HOST}"
    CONNECTOR_HOST="${SCANNER_CONNECTOR_HOST:-$CONNECTOR_HOST}"

    # Save originals for diff display (Pitfall 1: variable scope)
    local old_license="$SCANNER_LICENSE_KEY"
    local old_connector="$SCANNER_CONNECTOR_API_KEY"
    local old_reg_user="$SCANNER_REGISTRY_USER"
    local old_reg_pass="$SCANNER_REGISTRY_PASS"

    # Preserve infrastructure values for persist_config (Pitfall 7: CIDR globals)
    SELECTED_CLUSTER_CIDR="${CLUSTER_CIDR}"
    SELECTED_SERVICE_CIDR="${SERVICE_CIDR}"

    # Preserve original install timestamp (Pitfall 6: timestamp overwrite)
    local saved_timestamp="$INSTALL_TIMESTAMP"

    printf "%sReconfigure Detectify Scanner%s\n\n" "${BOLD}" "${NC}"
    printf "Current configuration:\n"
    display_config_summary
    printf "\nPress Enter to keep current value, or type a new one.\n\n"

    # Prompt for all four credentials with defaults (per D-06)
    prompt_with_default "License key" "$old_license" SCANNER_LICENSE_KEY false
    prompt_with_default "Connector API key" "$old_connector" SCANNER_CONNECTOR_API_KEY false
    prompt_with_default "Registry username" "$old_reg_user" SCANNER_REGISTRY_USER false
    prompt_with_default "Registry password" "$old_reg_pass" SCANNER_REGISTRY_PASS true

    # Validate changed credentials only (per D-07, D-08; Pitfall 3: skip unchanged)
    if [ "$SCANNER_LICENSE_KEY" != "$old_license" ]; then
        if ! validate_license_key_format "$SCANNER_LICENSE_KEY"; then
            printf "%sInvalid license key format. Must be at least 8 alphanumeric/dash characters.%s\n" "${RED}" "${NC}"
            return 1
        fi
    fi
    if [ "$SCANNER_CONNECTOR_API_KEY" != "$old_connector" ]; then
        if [ -z "$SCANNER_CONNECTOR_API_KEY" ]; then
            printf "%sConnector API key cannot be empty.%s\n" "${RED}" "${NC}"
            return 1
        fi
    fi
    if [ "$SCANNER_REGISTRY_USER" != "$old_reg_user" ] || \
       [ "$SCANNER_REGISTRY_PASS" != "$old_reg_pass" ]; then
        printf "Validating registry credentials...\n"
        validate_registry_credentials "$SCANNER_REGISTRY_USER" "$SCANNER_REGISTRY_PASS" || {
            printf "%sRegistry credential validation failed. Credentials not applied.%s\n" "${RED}" "${NC}"
            return 1
        }
    fi

    # Show diff and confirm (per D-10)
    show_changes_and_confirm \
        "$old_license" "$SCANNER_LICENSE_KEY" \
        "$old_connector" "$SCANNER_CONNECTOR_API_KEY" \
        "$old_reg_user" "$SCANNER_REGISTRY_USER" \
        "$old_reg_pass" "$SCANNER_REGISTRY_PASS" || {
        printf "No changes to apply.\n"
        return 0
    }

    # Apply changes in order (per D-11)
    printf "\n%sApplying changes...%s\n" "${BOLD}" "${NC}"

    # Preserve install timestamp by temporarily overriding _date_utc (Pitfall 6)
    _date_utc() { echo "$saved_timestamp"; }

    # Step 1: Update scanner.env
    printf "  Updating configuration...\n"
    persist_config

    # Restore _date_utc with known-safe body (avoids eval of captured function)
    _date_utc() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }

    # Step 2: Update registries.yaml (only if registry creds changed)
    if [ "$SCANNER_REGISTRY_USER" != "$old_reg_user" ] || \
       [ "$SCANNER_REGISTRY_PASS" != "$old_reg_pass" ]; then
        printf "  Updating registry authentication...\n"
        write_registries_yaml
    fi

    # Step 3: Regenerate HelmChart CRD
    printf "  Updating scanner deployment...\n"
    deploy_helm_chart || {
        printf "%sFailed to update deployment. Run 'detectify-scanner restart' to retry.%s\n" "${RED}" "${NC}"
        return 1
    }

    # Step 4: Restart pods to pick up new config
    printf "  Restarting scanner pods...\n"
    restart_command || {
        printf "%sPod restart failed. Run 'detectify-scanner restart' to retry.%s\n" "${RED}" "${NC}"
        return 1
    }

    # Wait for pods to be healthy
    wait_for_pods || {
        printf "%sPods did not become ready. Run 'detectify-scanner status' to check.%s\n" "${RED}" "${NC}"
        return 1
    }

    printf "\n%s%sReconfiguration complete.%s\n" "${GREEN}" "${BOLD}" "${NC}"
}

# --- Validation Functions ---
validate_license_key_format() {
    local key="$1"
    # Non-empty, alphanumeric + hyphens, at least 8 chars (per D-04)
    if [ -z "$key" ]; then
        return 1
    fi
    if ! echo "$key" | grep -qE '^[a-zA-Z0-9-]{8,}$'; then
        return 1
    fi
    return 0
}

validate_registry_credentials() {
    local user="$1" pass="$2"
    local http_code
    http_code=$(_curl_registry_auth "$user" "$pass")
    if [ "$http_code" = "200" ]; then
        return 0  # Valid
    elif [ "$http_code" = "401" ]; then
        return 1  # Invalid credentials
    else
        return 2  # Network/unexpected error
    fi
}

# --- Credential Prompting ---
prompt_credentials() {
    printf "\n%sCredential Collection%s\n" "${BOLD}" "${NC}"
    echo "====================="
    echo ""

    # License key (per D-01, D-04)
    _read_input "License key: " SCANNER_LICENSE_KEY
    if ! validate_license_key_format "$SCANNER_LICENSE_KEY"; then
        printf "\n%sError: Invalid license key format.%s\n" "${RED}" "${NC}"
        printf "Expected: alphanumeric string (hyphens allowed), at least 8 characters.\n"
        printf "Check your license key at https://detectify.com\n"
        return 1
    fi
    record_result "OK" "License key" "Format validated"

    # Connector API key (per D-01)
    _read_input "Connector API key: " SCANNER_CONNECTOR_API_KEY
    if [ -z "$SCANNER_CONNECTOR_API_KEY" ]; then
        printf "\n%sError: Connector API key cannot be empty.%s\n" "${RED}" "${NC}"
        printf "Find your connector API key at https://detectify.com\n"
        return 1
    fi
    record_result "OK" "Connector API key" "Provided"

    # Validate license key + API key against the license server
    printf "Validating license key and API key...\n"
    local license_http_code
    license_http_code=$(_curl_license_validate "$SCANNER_LICENSE_KEY" "$SCANNER_CONNECTOR_API_KEY") || true
    if [ "$license_http_code" = "200" ]; then
        record_result "OK" "License validation" "License key and API key validated"
    elif [ "$license_http_code" = "401" ]; then
        printf "\n%sError: Invalid connector API key.%s\n" "${RED}" "${NC}"
        printf "The API key was rejected by the license server.\n"
        printf "Check your connector API key at https://detectify.com\n"
        return 1
    elif [ "$license_http_code" = "400" ]; then
        printf "\n%sError: Invalid license key.%s\n" "${RED}" "${NC}"
        printf "The license key was not found on the license server.\n"
        printf "Check your license key at https://detectify.com\n"
        return 1
    else
        printf "%sWarning: Could not reach license server (HTTP %s). Skipping validation.%s\n" "${YELLOW}" "$license_http_code" "${NC}"
        record_result "WARN" "License validation" "Could not reach ${LICENSE_HOST} (HTTP ${license_http_code})"
    fi

    # Registry credentials with retry (per D-01, D-02, D-03)
    local attempts=0
    while [ "$attempts" -lt "$MAX_REGISTRY_ATTEMPTS" ]; do
        _read_input "Registry username: " SCANNER_REGISTRY_USER
        _read_secret "Registry password: " SCANNER_REGISTRY_PASS

        local result=0
        validate_registry_credentials "$SCANNER_REGISTRY_USER" "$SCANNER_REGISTRY_PASS" || result=$?

        if [ "$result" -eq 0 ]; then
            record_result "OK" "Registry credentials" "Validated against ${REGISTRY_HOST}"
            return 0
        fi

        attempts=$((attempts + 1))
        if [ "$result" -eq 1 ]; then
            if [ "$attempts" -lt "$MAX_REGISTRY_ATTEMPTS" ]; then
                printf "%sInvalid registry credentials. Attempt %d of %d.%s\n" \
                    "${YELLOW}" "$attempts" "$MAX_REGISTRY_ATTEMPTS" "${NC}"
            fi
        else
            printf "\n%sError: Unexpected error contacting %s.%s\n" "${RED}" "${REGISTRY_HOST}" "${NC}"
            printf "Check network connectivity to https://%s\n" "${REGISTRY_HOST}"
            return 1
        fi
    done

    printf "\n%sError: Registry credential validation failed after %d attempts.%s\n" "${RED}" "$MAX_REGISTRY_ATTEMPTS" "${NC}"
    printf "Verify your registry credentials at https://detectify.com/settings\n"
    return 1
}

